{
  "name": "icloud-calendar-mcp",
  "version": "0.1.0",
  "description": "Remote MCP server exposing iCloud Calendar via CalDAV, hosted on Cloudflare Workers",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "test": "bun test",
    "typecheck": "wrangler types && tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "lint": "biome check ."
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^1.2.3",
    "@modelcontextprotocol/server": "2.3.1",
    "agents": "^0.28.1",
    "fast-xml-parser": "^5.11.2",
    "ical.js": "^2.2.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/bun": "^1.4.3",
    "typescript": "^7.0.2",
    "wrangler": "^4.151.0"
  }
}
