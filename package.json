{
  "name": "icloud-calendar-mcp",
  "version": "0.1.0",
  "description": "Remote MCP server exposing iCloud Calendar via CalDAV, hosted on Cloudflare Workers",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist",
    "plan": "scripts/terraform.sh plan",
    "deploy": "scripts/terraform.sh apply",
    "test": "bun test",
    "typecheck": "wrangler types && tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "lint": "biome check . && terraform -chdir=terraform fmt -check"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^1.2.1",
    "@modelcontextprotocol/server": "2.0.0",
    "agents": "^0.24.0",
    "fast-xml-parser": "^5.11.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/bun": "^1.4.2",
    "typescript": "^7.0.2",
    "wrangler": "^4.143.0"
  }
}
